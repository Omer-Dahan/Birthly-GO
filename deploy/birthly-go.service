[Unit]
Description=Birthly Telegram Bot — Go rewrite (בלי פאדיחות)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=birthly-go
Group=birthly-go
WorkingDirectory=/opt/birthly-go
ExecStart=/opt/birthly-go/birthly
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/birthly-go/data

# Deliberately aggressive vs. the Python unit's 512M: the whole point of
# the rewrite is a small static binary with a small heap (~20-35MB RSS
# target). Setting the cap this low during shadow-run and the first
# production weeks turns any leak (FSM store, rate-limit buckets, the
# outbound send-rate limiter) into an immediate OOM-kill + systemd
# restart instead of a slow multi-day climb that's easy to miss.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
